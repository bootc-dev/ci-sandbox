FROM scratch AS ctx

COPY ../shared/ /shared

FROM registry.opensuse.org/opensuse/tumbleweed:latest AS base

FROM base AS builder

RUN zypper install -y binutils cargo git go-md2man libostree-devel make rust

WORKDIR /home/build
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/shared/build.sh

FROM base AS system

COPY --from=builder /output /

RUN zypper install -y btrfs-progs bubblewrap cpio dosfstools dracut dracut e2fsprogs glib2 kernel-default kernel-firmware-all NetworkManager openssh ostree skopeo systemd systemd-boot udev xfsprogs zstd libcrypto57 chrony

RUN systemctl enable NetworkManager chronyd sshd

# Wildcard NM connection: bring up any ethernet interface via DHCP.
# Without an explicit connection profile, NM may not manage the QEMU virtio
# NIC if no other connection matches it (e.g., no cloud-init/ifcfg files).
RUN mkdir -p /etc/NetworkManager/system-connections && \
    printf '[connection]\nid=ethernet-dhcp\ntype=ethernet\nautoconnect-priority=-999\n\n[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n' \
    > /etc/NetworkManager/system-connections/10-ethernet-dhcp.nmconnection && \
    chmod 600 /etc/NetworkManager/system-connections/10-ethernet-dhcp.nmconnection

RUN --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/root \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/shared/initramfs.sh

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    echo "HOME=/var/home" | tee -a "/etc/default/useradd" && \
    /ctx/shared/bootc-rootfs.sh

RUN rm -rf /usr/etc

LABEL containers.bootc 1

RUN bootc container lint
